# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT: anything prefixed with VITE_ is compiled into the public JavaScript
# bundle. Anyone can read it in DevTools. Only put values here that are safe to
# be public — a form endpoint is fine, an email API key is NOT.

# Endpoint that receives the "Let's connect" form (Formspree, Web3Forms, etc.)
VITE_FORM_ENDPOINT=

# Where the primary CTA sends people (Calendly link, signup page, ...)
VITE_CTA_URL=
